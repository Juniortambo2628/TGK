# Good Kenyan Foundation — production environment template
# Copy to the server as TGK-core/.env and fill in the real secrets.
# NEVER commit the filled-in file (this .example is the only version in git).

APP_NAME="Good Kenyan Foundation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi

# Canonical domain. goodkenyan.com 301-redirects to goodkenyan.org (see public/.htaccess).
APP_URL=https://goodkenyan.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (cPanel → MySQL Databases) -------------------------------------
# cPanel prefixes DB + user with the account name. Confirm the EXACT full names
# in cPanel; they are typically <cpuser>_<name>, e.g. a040j9v5l2vz_TGK-site.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=a040j9v5l2vz_TGK-site
DB_USERNAME=a040j9v5l2vz_TGKADM
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null so the session cookie works on whichever host is being served.
SESSION_DOMAIN=null
# Site is HTTPS-only (forced in public/.htaccess) — only send cookies over TLS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=tgk_

# --- Mail (cPanel email: system@goodkenyan.com) ------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.goodkenyan.com
MAIL_PORT=465
MAIL_USERNAME=system@goodkenyan.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="system@goodkenyan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shared hosting cannot run a long-lived Node SSR process.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

DONATE_URL=
