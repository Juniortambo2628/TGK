# Good Kenyan Foundation — production environment template
# Copy to the server as TGK-core/.env and fill in secrets. Never commit the real file.

APP_NAME="Good Kenyan Foundation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Nairobi
APP_URL=https://goodkenyan.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=tgk_

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.goodkenyan.org
MAIL_PORT=465
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="system@goodkenyan.org"
MAIL_FROM_NAME="${APP_NAME}"

# Shared hosting cannot run a long-lived Node SSR process.
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"

DONATE_URL=
