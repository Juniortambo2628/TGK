<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- Canonical host + HTTPS (managed via SSL on GoDaddy) ------------------
    # Force HTTPS (skip if already forwarded as https by a proxy/load balancer).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect goodkenyan.com (and www.goodkenyan.com) to the canonical
    # goodkenyan.org so both registered domains serve one canonical URL set.
    RewriteCond %{HTTP_HOST} ^(www\.)?goodkenyan\.com$ [NC]
    RewriteRule ^ https://goodkenyan.org%{REQUEST_URI} [L,R=301]

    # Drop www. on the canonical domain.
    RewriteCond %{HTTP_HOST} ^www\.goodkenyan\.org$ [NC]
    RewriteRule ^ https://goodkenyan.org%{REQUEST_URI} [L,R=301]
    # -------------------------------------------------------------------------

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
